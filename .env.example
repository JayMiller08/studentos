# ── StudentOS environment ────────────────────────────────────────────────
# Copy to `.env.local` for development. Set the same variables in Vercel for
# Preview and Production environments (never commit real values).
#
# When VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are omitted, the app runs in
# "local demo mode": auth is simulated and data is persisted to this device
# only. Perfect for local UX work without a backend.

# Supabase (Project settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of this deployment (used for auth email redirects)
VITE_APP_URL=http://localhost:5173

# development | preview | production
VITE_APP_ENV=development

# ── Server-side secrets (Supabase Edge Functions; set via `supabase secrets set`)
# GEMINI_API_KEY=           AI study coach + Smart Plan notes (Google AI Studio)
# GEMINI_MODEL=             Optional; defaults to gemini-2.5-flash
# GEMINI_THINKING_BUDGET=   Optional; tokens the model may spend reasoning
#                           before writing (default 2048). Deducted from the
#                           output limit — raise for harder reasoning, lower if
#                           long answers are still being cut short.
#
# ── Payments — Paystack (the live processor; plans are priced in ZAR) ────────
# PAYSTACK_SECRET_KEY=      sk_live_… / sk_test_… (Paystack → Settings → API Keys)
#                           Also the key the webhook signature is verified with.
# PAYSTACK_PLAN_PRO_MONTHLY=   PLN_… plan code for Student Pro
# PAYSTACK_PLAN_ELITE_MONTHLY= PLN_… plan code for Student Elite
#
# ── Payments — Stripe (kept for markets Paystack doesn't serve; unused today)
# STRIPE_SECRET_KEY=        Billing
# STRIPE_WEBHOOK_SECRET=    Billing webhooks
# STRIPE_PRICE_PRO_MONTHLY= Price id for Student Pro
# STRIPE_PRICE_ELITE_MONTHLY= Price id for Student Elite
