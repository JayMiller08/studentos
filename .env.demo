# Local demo mode for UI verification, loaded only with `vite --mode demo`.
# Blanking the Supabase pair puts the app in its localStorage demo store, so the
# whole product can be exercised without a backend or a sign-in.
# Never referenced by a build; `.env` is untouched.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5174
VITE_APP_ENV=development
